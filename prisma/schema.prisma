generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
}

enum SubmissionStatus {
  not_submitted
  submitted
  ai_done
  graded
}

model User {
  id             BigInt    @id @default(autoincrement())
  role           Role
  username       String    @unique
  password       String
  name           String
  school         String
  student_number String?
  subject        String?
  profile_image  String    @default("")
  created_at     DateTime  @default(now())

  taught_classes  Class[]          @relation("TeacherClasses")
  class_students  ClassStudent[]
  submissions     Submission[]
  metrics         StudentMetrics?
  score_histories StudentScoreHistory[]
}

model Class {
  id          Int      @id @default(autoincrement())
  name        String
  teacher_id  BigInt
  invite_code String   @unique @db.VarChar(8)
  created_at  DateTime @default(now())

  teacher     User           @relation("TeacherClasses", fields: [teacher_id], references: [id])
  students    ClassStudent[]
  assignments Assignment[]
}

model ClassStudent {
  id         Int      @id @default(autoincrement())
  class_id   Int
  student_id BigInt
  joined_at  DateTime @default(now())

  class   Class @relation(fields: [class_id], references: [id])
  student User  @relation(fields: [student_id], references: [id])

  @@unique([class_id, student_id])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  class_id    Int
  title       String
  description String   @db.Text
  due_date    DateTime
  created_at  DateTime @default(now())

  class           Class                @relation(fields: [class_id], references: [id])
  submissions     Submission[]
  score_histories StudentScoreHistory[]
}

model Submission {
  id            Int              @id @default(autoincrement())
  assignment_id Int
  student_id    BigInt
  text_content  String           @db.LongText
  status        SubmissionStatus @default(not_submitted)
  submitted_at  DateTime?

  assignment      Assignment       @relation(fields: [assignment_id], references: [id])
  student         User             @relation(fields: [student_id], references: [id])
  images          SubmissionImage[]
  ai_feedback     AIFeedback?
  teacher_feedback TeacherFeedback?
}

model SubmissionImage {
  id            Int      @id @default(autoincrement())
  submission_id Int
  image_url     String
  created_at    DateTime @default(now())

  submission Submission @relation(fields: [submission_id], references: [id])
}

model AIFeedback {
  id                      Int      @id @default(autoincrement())
  submission_id           Int      @unique
  summary                 String   @db.Text
  detail_analysis         Json
  improvement_suggestions Json
  created_at              DateTime @default(now())

  submission Submission @relation(fields: [submission_id], references: [id])
}

model TeacherFeedback {
  id            Int      @id @default(autoincrement())
  submission_id Int      @unique
  score         Int
  feedback      String   @db.Text
  created_at    DateTime @default(now())

  submission Submission @relation(fields: [submission_id], references: [id])
}

model StudentMetrics {
  id           Int      @id @default(autoincrement())
  student_id   BigInt   @unique
  logical      Int      @default(0)
  structure    Int      @default(0)
  grammar      Int      @default(0)
  creativity   Int      @default(0)
  understanding Int     @default(0)
  updated_at   DateTime @updatedAt

  student User @relation(fields: [student_id], references: [id])
}

model StudentScoreHistory {
  id            Int      @id @default(autoincrement())
  student_id    BigInt
  assignment_id Int
  score         Int
  created_at    DateTime @default(now())

  student    User       @relation(fields: [student_id], references: [id])
  assignment Assignment @relation(fields: [assignment_id], references: [id])
}